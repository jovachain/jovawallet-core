{
  "name": "@jovachain/wallet-core",
  "version": "0.0.1",
  "private": true,
  "description": "WASM binding for jovawallet-core (EVM + SOL signing; BTC + XRP deferred — see COVERAGE.md)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./evm": {
      "types": "./src/evm.ts",
      "import": "./src/evm.ts"
    },
    "./sol": {
      "types": "./src/sol.ts",
      "import": "./src/sol.ts"
    },
    "./init": {
      "types": "./pkg/jova_core_wasm.d.ts",
      "import": "./pkg/jova_core_wasm.js"
    }
  },
  "files": [
    "pkg/",
    "src/",
    "README.md",
    "COVERAGE.md"
  ],
  "scripts": {
    "build": "./scripts/build-wasm.sh",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^4.1.0",
    "typescript": "^5.5.0"
  }
}
